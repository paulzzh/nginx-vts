diff --git a/src/event/ngx_event_connect.c b/src/event/ngx_event_connect.c
index e18b3a5c6..d92221797 100644
--- a/src/event/ngx_event_connect.c
+++ b/src/event/ngx_event_connect.c
@@ -38,7 +38,18 @@ ngx_event_connect_peer(ngx_peer_connection_t *pc)
 
     type = (pc->type ? pc->type : SOCK_STREAM);
 
-    s = ngx_socket(pc->sockaddr->sa_family, type, 0);
+    int protocol = 0;
+
+#if (NGX_LINUX)
+    if ((pc->sockaddr->sa_family == AF_INET ||
+        pc->sockaddr->sa_family == AF_INET6)
+        && ((type & 0xff) == SOCK_STREAM))
+    {
+        protocol = IPPROTO_MPTCP;
+    }
+#endif
+
+    s = ngx_socket(pc->sockaddr->sa_family, type, protocol);
 
     ngx_log_debug2(NGX_LOG_DEBUG_EVENT, pc->log, 0, "%s socket %d",
                    (type == SOCK_STREAM) ? "stream" : "dgram", s);
